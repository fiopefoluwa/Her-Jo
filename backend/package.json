{
  "name": "herjo-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.js",
    "dev": "tsx watch src/server.js",
    "build": "prisma generate",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx src/data/seed.js",
    "db:reset": "prisma migrate reset --force && tsx src/data/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.5.0",
    "pg": "^8.13.3",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
